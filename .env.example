# Copy to .env and export (or use your process manager) -- the app reads real environment variables.
DATABASE_URL=sqlite:///./data/certificates.db
STORAGE_DIR=./data/certificates
PROCESSING_MODE=background      # background | inline
WORKER_THREADS=2
MAX_RECIPIENTS_PER_JOB=5000
RESUME_UNFINISHED_JOBS=true
# API_KEY=your-secret-api-key      # Optional: require X-API-Key header on /api/v1 routes
